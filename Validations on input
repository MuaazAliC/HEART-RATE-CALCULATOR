    string input;
    cout << "Enter " << name << ": ";
    getline(cin, input);
    while (!isValidValidation(input, validationRegex, maxLength)) {
        cout << "\nInvalid " << name << " \n . Please enter a valid " << name << " like ---> " << examples << "\nEnter " << name << " again : ";
        getline(cin, input);
    }
    return input;
}

